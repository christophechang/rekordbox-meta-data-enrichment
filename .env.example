# LLM disambiguation — provider cascade
# At least one required; Mistral is preferred
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: Discogs authenticated lookups (60/min unauth, 25/min auth)
DISCOGS_TOKEN=

# Beatport (primary metadata source) — either a static bearer token
# OR client-credentials (client id + secret). Leave blank to skip Beatport.
BEATPORT_API_TOKEN=
BEATPORT_CLIENT_ID=
BEATPORT_CLIENT_SECRET=
