# LLM disambiguation — provider cascade
# At least one required; Mistral is preferred
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional: Discogs authenticated lookups (60/min unauth, 25/min auth)
DISCOGS_TOKEN=

# Beatport (primary metadata source) — account login drives a PKCE
# authorization-code flow. Leave blank to skip Beatport.
BEATPORT_USERNAME=
BEATPORT_PASSWORD=
